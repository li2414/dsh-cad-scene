{
  "name": "dsh-cad-scene",
  "version": "0.1.0",
  "description": "DSH plugin: parse CAD drawings (DXF/DWG) into logistics-warehouse 3D scenes — sidebar dual-pane panel with Three.js preview, the parse_cad_to_scene tool, and a 3D tool card.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "sample",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cad",
    "dwg",
    "dxf",
    "threejs",
    "warehouse",
    "logistics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/li2414/dsh-cad-scene.git"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2"
  },
  "devDependencies": {
    "three": "^0.186.0",
    "esbuild": "^0.28.2"
  }
}
